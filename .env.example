# GitHub source for ingest (scripts/ingest.ts)
GITHUB_USER=ujjwalredd
# Optional: org instead of user. If set, takes precedence.
GITHUB_ORG=
# Personal access token (read-only, public_repo). Raises rate limit + private repos.
GITHUB_TOKEN=

# PuppyGraph — openCypher over Bolt (server-side only). Leave unset to use the
# in-process snapshot fallback. Set to enable live graph queries.
PUPPYGRAPH_BOLT=bolt://localhost:7687
PUPPYGRAPH_USER=puppygraph
PUPPYGRAPH_PASSWORD=puppygraph123
